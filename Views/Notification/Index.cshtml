@model List<Notification>
@{ ViewData["Title"] = "Nhật ký gửi"; var st = (NotiStatus?)ViewBag.Status; var ch = (Channel?)ViewBag.Channel; }
<div class="card"><div class="card-body">
    <div class="d-flex gap-2 mb-3 flex-wrap">
        <a href="/Notification" class="btn btn-sm @(st==null&&ch==null?"btn-primary":"btn-outline-primary")">Tất cả</a>
        @foreach (NotiStatus s in Enum.GetValues(typeof(NotiStatus))) { var (t,_)=Ui.Stat(s); <a href="/Notification?status=@((int)s)" class="btn btn-sm @(st==s?"btn-primary":"btn-outline-primary")">@t</a> }
        <span class="vr"></span>
        @foreach (Channel c in Enum.GetValues(typeof(Channel))) { var (t,_,_)=Ui.Chan(c); <a href="/Notification?channel=@((int)c)" class="btn btn-sm @(ch==c?"btn-primary":"btn-outline-primary")">@t</a> }
    </div>
    <table class="table table-hover align-middle">
        <thead><tr><th>Thời gian</th><th>Kênh</th><th>Đến</th><th>Nội dung</th><th>NCC</th><th>Trạng thái</th></tr></thead>
        <tbody>
        @foreach (var n in Model)
        {
            var (ct, ccss, cicon) = Ui.Chan(n.Channel); var (st2, scss) = Ui.Stat(n.Status);
            <tr style="cursor:pointer" onclick="location.href='/Notification/Detail/@n.Id'">
                <td class="small text-muted">@n.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                <td><span class="badge bg-@ccss"><i class="bi @cicon me-1"></i>@ct</span></td>
                <td class="small">@n.ToAddress</td>
                <td class="small text-muted text-truncate" style="max-width:220px">@(string.IsNullOrEmpty(n.Subject) ? n.Body : n.Subject)</td>
                <td class="small">@n.Provider</td>
                <td><span class="badge bg-@scss">@st2</span>@if (n.RetryCount > 0) { <span class="badge bg-light text-dark border ms-1">↻@n.RetryCount</span> }</td>
            </tr>
        }
        @if (Model.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-4">Không có thông báo.</td></tr> }
        </tbody>
    </table>
</div></div>
