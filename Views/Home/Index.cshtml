@{ ViewData["Title"] = "Bảng điều khiển"; var d = (NotifyDash)ViewBag.Dash;
   var rate = d.Total == 0 ? 0 : (d.Sent + d.Delivered) * 100 / d.Total; }
<div class="row g-3 mb-3">
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><div class="text-muted small">Tổng gửi</div><div class="stat-num" style="color:#ea580c">@d.Total</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><div class="text-muted small">Đã nhận</div><div class="stat-num text-success">@d.Delivered</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><div class="text-muted small">Thất bại</div><div class="stat-num text-danger">@d.Failed</div></div></div></div>
    <div class="col-6 col-lg-3"><div class="card"><div class="card-body"><div class="text-muted small">Tỉ lệ gửi thành công</div><div class="stat-num">@rate%</div></div></div></div>
</div>
<div class="row g-3">
    <div class="col-lg-5"><div class="card"><div class="card-body">
        <h6 class="fw-bold mb-3">Theo kênh</h6>
        @foreach (Channel c in Enum.GetValues(typeof(Channel)))
        {
            var (t, css, icon) = Ui.Chan(c);
            var n = d.ByChannel.TryGetValue(c, out var v) ? v : 0;
            var pct = d.Total == 0 ? 0 : n * 100 / d.Total;
            <div class="mb-2"><div class="d-flex justify-content-between small"><span><i class="bi @icon me-1"></i>@t</span><span class="text-muted">@n</span></div>
                <div class="progress" style="height:7px"><div class="progress-bar bg-@css" style="width:@pct%"></div></div></div>
        }
    </div></div></div>
    <div class="col-lg-7"><div class="card"><div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2"><h6 class="fw-bold mb-0">Gửi gần đây</h6><a href="/Template" class="small">Gửi mới →</a></div>
        <table class="table table-hover align-middle mb-0">
            <thead><tr><th>Kênh</th><th>Đến</th><th>Nội dung</th><th>Trạng thái</th></tr></thead>
            <tbody>
            @foreach (var n in d.Recent)
            {
                var (ct, ccss, cicon) = Ui.Chan(n.Channel); var (st, scss) = Ui.Stat(n.Status);
                <tr style="cursor:pointer" onclick="location.href='/Notification/Detail/@n.Id'">
                    <td><span class="badge bg-@ccss"><i class="bi @cicon me-1"></i>@ct</span></td>
                    <td class="small">@n.ToAddress</td>
                    <td class="small text-muted text-truncate" style="max-width:180px">@(string.IsNullOrEmpty(n.Subject) ? n.Body : n.Subject)</td>
                    <td><span class="badge bg-@scss">@st</span></td>
                </tr>
            }
            @if (d.Recent.Count == 0) { <tr><td colspan="4" class="text-center text-muted py-3">Chưa có thông báo.</td></tr> }
            </tbody>
        </table>
    </div></div></div>
</div>
